# ===== LLM Configuration =====
# Set ONE of the following API keys. Anthropic takes priority if both are set.

# Option 1: Anthropic Claude API (direct, recommended for Claude models)
# Get your API key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option 2: OpenRouter (access Claude, Qwen, and hundreds of other models)
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ===== Model Configuration =====
# Model to use for all agents. Examples:
#
# OpenRouter models:
#   qwen/qwen3.5-122b-a10b         (recommended - fast, powerful, cost-effective)
#   anthropic/claude-sonnet-4-20250514
#   anthropic/claude-opus-4-20250514
#   google/gemini-2.5-pro
#   meta-llama/llama-4-maverick
#
# Anthropic direct models:
#   claude-sonnet-4-20250514
#   claude-opus-4-20250514
#   claude-haiku-4-5-20251001
#
LLM_MODEL_NAME=qwen/qwen3.5-122b-a10b

# ===== Zep Cloud Configuration =====
# Knowledge graph memory for agent interactions
# Free tier available at https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Boost Configuration (Optional) =====
# Secondary API key for parallel simulations to increase throughput
# ANTHROPIC_BOOST_API_KEY=your_second_api_key
# LLM_BOOST_MODEL_NAME=claude-haiku-4-5-20251001
