# ===== LLM Configuration =====
# Set ONE of the following API keys. Anthropic takes priority if both are set.

# Option 1: Anthropic Claude API (direct, recommended)
# Get your API key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option 2: OpenRouter (access Claude + other models)
# Get your API key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Claude model to use for all agents
# Works with both Anthropic and OpenRouter
# Recommended: claude-sonnet-4-20250514 (balanced speed + intelligence)
# Premium:     claude-opus-4-20250514 (maximum intelligence)
# Fast:        claude-haiku-4-5-20251001 (fastest, most cost-effective)
CLAUDE_MODEL_NAME=claude-sonnet-4-20250514

# ===== Zep Cloud Configuration =====
# Knowledge graph memory for agent interactions
# Free tier available at https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Boost Configuration (Optional) =====
# Secondary API key for parallel simulations to increase throughput
# ANTHROPIC_BOOST_API_KEY=your_second_anthropic_api_key
# CLAUDE_BOOST_MODEL_NAME=claude-haiku-4-5-20251001
